DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_tickets?schema=public"
PORT=3000
SWAGGER_ENABLED=true

# Access and refresh tokens are signed with different secrets on purpose:
# a mistake in one place cannot turn a refresh token into an API credential.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

BCRYPT_ROUNDS=12
